# Connect to Supabase via connection pooling. Used by the running app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used by Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Auth. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-only Supabase admin key. Never expose this as NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Private code required for trainer self-registration.
TRAINER_SIGNUP_CODE="CHANGE_ME_TO_A_LONG_RANDOM_CODE"

# Public site URL used for password reset links.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
